secrets.json
.env
.env.*
!.env.example
*.key
*.pem
secrets/
*secret*
*credential*

# ---- 本地专用配置 ----
config.local.*
settings.local.*

# ---- Python / 系统杂项 ----
__pycache__/
*.pyc
.DS_Store
Thumbs.db
